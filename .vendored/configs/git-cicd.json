{
  "jobs": {
    "test": {
      "name": "Unit Tests",
      "on": ["open"],
      "branches": ["**"],
      "paths": ["git-semver", "release", "install.sh", "templates/**", "tests/**", "pyproject.toml", "ci/**"],
      "setup": "ci/setup.sh",
      "steps": ["ci/test.sh"]
    },
    "vendor-check": {
      "name": "Vendor Check",
      "on": ["open"],
      "branches": ["**"],
      "paths": ["**"],
      "steps": [".vendored/check"]
    },
    "version-check": {
      "name": "Version Check",
      "on": ["open"],
      "branches": ["main"],
      "paths": ["**"],
      "steps": [["git-semver", "check-bump"]]
    },
    "release": {
      "name": "Release",
      "on": ["merge"],
      "branches": ["main"],
      "paths": ["**"],
      "steps": ["release"]
    },
    "update-vendored": {
      "name": "Install Vendored",
      "on": ["cron"],
      "cron": "0 9 * * 1",
      "branches": ["main"],
      "paths": ["**"],
      "steps": ["ci/update-vendored.sh"],
      "inputs": {
        "vendor": {
          "description": "Vendor to update (or all)",
          "default": "all"
        },
        "version": {
          "description": "Version to install (default: latest)",
          "default": "latest"
        },
        "private": {
          "description": "Vendor repo is private (use VENDOR_PAT)",
          "choices": ["true", "false"],
          "default": "false"
        }
      }
    }
  },
  "needs_nothing": [
    "*.md",
    "LICENSE",
    "docs/**",
    "commands/*.md",
    ".pearls/issues.jsonl",
    ".pearls/archive/**",
    ".pearls/docs/**",
    ".madreperla/sessions.jsonl"
  ]
}
